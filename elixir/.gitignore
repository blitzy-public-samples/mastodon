# Generated output and local secrets for the Elixir application in this directory.
# The repository root .gitignore covers Ruby, Node, editor, and operating-system files.

# Ignore Mix build output.
/_build/
/cover/

# Ignore dependency sources fetched by Mix.
/deps/
/.fetch

# Ignore documentation generated by ExDoc.
/doc/

# Ignore Dialyzer persistent lookup tables.
/priv/plts/*.plt
/priv/plts/*.plt.hash

# Ignore release artifacts.
/tmp/
mastodon-*.tar
mastodon-*.tar.gz

# Ignore compiled bytecode, archives, and native libraries.
*.beam
*.ez
*.o
*.so
/priv/native/

# Ignore Erlang VM crash dumps.
erl_crash.dump

# Ignore the asset digest manifest written by mix phx.digest.
/priv/static/cache_manifest.json

# Ignore secrets and local overrides.
.env
.env.production
.env.*
.env*.local
!.env*.sample

# Ignore language server caches.
/.elixir_ls/
/.lexical/
.elixir-tools/
