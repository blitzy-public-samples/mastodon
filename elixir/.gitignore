# The directory Mix downloads your dependencies sources to.
/deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Temporary files, for example, from tests.
/tmp/

# Mix artifacts.
/_build/
/cover/
/priv/plts/*.plt
/priv/plts/*.plt.hash

# Compiled static assets served by the endpoint.
/priv/static/assets/
/priv/static/cache_manifest.json

# Secrets and local overrides. Configuration is read from the environment at
# runtime using the variable names in .env.production.sample.
/.env
/.env.*
!/.env.production.sample

# Language server and editor scratch directories.
/.elixir_ls/
/.lexical/
.elixir-tools/
